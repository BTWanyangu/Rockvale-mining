{
  "name": "rockvalle-resources",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs && node scripts/asset-inventory.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run build && node scripts/check-build.mjs && node scripts/check-server.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "nodemailer": "^10.0.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
