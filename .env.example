# Public frontend settings. These are embedded in the build. No secrets here.
# Set to an actual https:// domain before building for launch; leave blank for review.
VITE_SITE_URL=
VITE_PUBLIC_INDEXING=false
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
VITE_CONTACT_HOURS=
# Empty uses the same-origin Express API. Only use an https:// API origin for a split deployment.
VITE_API_BASE=

# Server-only settings. Enable only with confirmed contact information and SMTP credentials.
PORT=8080
NODE_ENV=production
SITE_URL=
CONTACT_ENABLED=false
CONTACT_ALLOWED_ORIGINS=
# Zero for direct access. Set the exact known reverse-proxy hop count when applicable.
TRUST_PROXY_HOPS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
